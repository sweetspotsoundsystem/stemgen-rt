set(STEMGENRT_QUALIFIED_METADATA_RESIDUAL_SOURCE_NAME "other")
set(STEMGENRT_QUALIFIED_METADATA_EXTERNAL_OVERLAP_ADD "false")
set(STEMGENRT_QUALIFIED_METADATA_FUSION_HIDDEN_SHAPE
