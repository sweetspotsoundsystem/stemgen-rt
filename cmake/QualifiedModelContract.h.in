#pragma once

#include <array>
#include <cstddef>
#include <cstdint>
#include <string_view>

namespace audio_plugin::qualified_model {

inline constexpr std::string_view kContractId =
    "@STEMGENRT_QUALIFIED_CONTRACT_ID@";
inline constexpr std::string_view kModelSha256 =
    "@STEMGENRT_QUALIFIED_MODEL_SHA256@";
inline constexpr std::int64_t kModelByteSize =
    @STEMGENRT_QUALIFIED_MODEL_BYTE_SIZE@;
inline constexpr std::string_view kCheckpointSha256 =
    "@STEMGENRT_QUALIFIED_CHECKPOINT_SHA256@";
inline constexpr std::string_view kHeadStateSha256 =
    "@STEMGENRT_QUALIFIED_HEAD_STATE_SHA256@";

inline constexpr int kSampleRate = @STEMGENRT_QUALIFIED_SAMPLE_RATE@;
inline constexpr int kNumChannels = @STEMGENRT_QUALIFIED_CHANNELS@;
inline constexpr int kNumStems = @STEMGENRT_QUALIFIED_STEMS@;
inline constexpr int kHopSamples = @STEMGENRT_QUALIFIED_HOP_SAMPLES@;
inline constexpr int kAnalysisWindowSamples =
    @STEMGENRT_QUALIFIED_ANALYSIS_WINDOW_SAMPLES@;
inline constexpr int kFusionHiddenLayers =
    @STEMGENRT_QUALIFIED_FUSION_HIDDEN_LAYERS@;
inline constexpr int kFusionHiddenSize =
    @STEMGENRT_QUALIFIED_FUSION_HIDDEN_SIZE@;
inline constexpr int kC130FeatureChannels =
    @STEMGENRT_QUALIFIED_C130_FEATURE_CHANNELS@;
inline constexpr int kC130HistorySamples =
    @STEMGENRT_QUALIFIED_C130_HISTORY_SAMPLES@;
inline constexpr int kC155HiddenChannels =
    @STEMGENRT_QUALIFIED_C155_HIDDEN_CHANNELS@;
inline constexpr int kC155HistorySamples =
    @STEMGENRT_QUALIFIED_C155_HISTORY_SAMPLES@;
inline constexpr int kModelOutputDelayChunks =
    @STEMGENRT_QUALIFIED_MODEL_OUTPUT_DELAY_CHUNKS@;
inline constexpr int kPdcSamples = @STEMGENRT_QUALIFIED_HOP_SAMPLES@;
inline constexpr int kDrumsSourceIndex =
    @STEMGENRT_QUALIFIED_DRUMS_SOURCE_INDEX@;
inline constexpr int kBassSourceIndex =
    @STEMGENRT_QUALIFIED_BASS_SOURCE_INDEX@;
inline constexpr int kVocalsSourceIndex =
    @STEMGENRT_QUALIFIED_VOCALS_SOURCE_INDEX@;
inline constexpr int kOtherSourceIndex =
    @STEMGENRT_QUALIFIED_OTHER_SOURCE_INDEX@;
inline constexpr int kResidualSourceIndex =
    @STEMGENRT_QUALIFIED_RESIDUAL_SOURCE_INDEX@;
inline constexpr auto kSourceOrder = std::to_array<int>({
    kDrumsSourceIndex,
    kBassSourceIndex,
    kVocalsSourceIndex,
    kOtherSourceIndex,
});

inline constexpr auto kInputNames = std::to_array<std::string_view>({
    "@STEMGENRT_QUALIFIED_INPUT_AUDIO_NAME@",
    "@STEMGENRT_QUALIFIED_INPUT_PAST_NAME@",
    "@STEMGENRT_QUALIFIED_INPUT_HIDDEN_NAME@",
    "@STEMGENRT_QUALIFIED_INPUT_C130_HISTORY_NAME@",
    "@STEMGENRT_QUALIFIED_INPUT_PREVIOUS_HIDDEN_NAME@",
    "@STEMGENRT_QUALIFIED_INPUT_ADAPTER_VALID_NAME@",
});
inline constexpr auto kOutputNames = std::to_array<std::string_view>({
    "@STEMGENRT_QUALIFIED_OUTPUT_SEPARATED_NAME@",
    "@STEMGENRT_QUALIFIED_OUTPUT_PAST_NAME@",
    "@STEMGENRT_QUALIFIED_OUTPUT_HIDDEN_NAME@",
    "@STEMGENRT_QUALIFIED_OUTPUT_C130_HISTORY_NAME@",
    "@STEMGENRT_QUALIFIED_OUTPUT_PREVIOUS_HIDDEN_NAME@",
    "@STEMGENRT_QUALIFIED_OUTPUT_ADAPTER_VALID_NAME@",
});

inline constexpr auto kInputAudioShape =
    std::to_array<std::int64_t>({@STEMGENRT_QUALIFIED_INPUT_AUDIO_SHAPE@});
inline constexpr auto kInputPastShape =
    std::to_array<std::int64_t>({@STEMGENRT_QUALIFIED_INPUT_PAST_SHAPE@});
inline constexpr auto kInputHiddenShape =
    std::to_array<std::int64_t>({@STEMGENRT_QUALIFIED_INPUT_HIDDEN_SHAPE@});
inline constexpr auto kInputC130HistoryShape = std::to_array<std::int64_t>(
    {@STEMGENRT_QUALIFIED_INPUT_C130_HISTORY_SHAPE@});
inline constexpr auto kInputPreviousHiddenShape = std::to_array<std::int64_t>(
    {@STEMGENRT_QUALIFIED_INPUT_PREVIOUS_HIDDEN_SHAPE@});
inline constexpr auto kInputAdapterValidShape = std::to_array<std::int64_t>(
    {@STEMGENRT_QUALIFIED_INPUT_ADAPTER_VALID_SHAPE@});
inline constexpr auto kOutputSeparatedShape = std::to_array<std::int64_t>(
    {@STEMGENRT_QUALIFIED_OUTPUT_SEPARATED_SHAPE@});
inline constexpr auto kOutputPastShape =
    std::to_array<std::int64_t>({@STEMGENRT_QUALIFIED_OUTPUT_PAST_SHAPE@});
inline constexpr auto kOutputHiddenShape =
    std::to_array<std::int64_t>({@STEMGENRT_QUALIFIED_OUTPUT_HIDDEN_SHAPE@});
inline constexpr auto kOutputC130HistoryShape = std::to_array<std::int64_t>(
    {@STEMGENRT_QUALIFIED_OUTPUT_C130_HISTORY_SHAPE@});
inline constexpr auto kOutputPreviousHiddenShape =
    std::to_array<std::int64_t>(
        {@STEMGENRT_QUALIFIED_OUTPUT_PREVIOUS_HIDDEN_SHAPE@});
inline constexpr auto kOutputAdapterValidShape = std::to_array<std::int64_t>(
    {@STEMGENRT_QUALIFIED_OUTPUT_ADAPTER_VALID_SHAPE@});

inline constexpr std::string_view kExportMode =
    "@STEMGENRT_QUALIFIED_METADATA_EXPORT_MODE@";
inline constexpr std::string_view kMixtureConsistency =
    "@STEMGENRT_QUALIFIED_METADATA_MIXTURE_CONSISTENCY@";
inline constexpr std::string_view kExternalData =
    "@STEMGENRT_QUALIFIED_METADATA_EXTERNAL_DATA@";
inline constexpr std::string_view kOutputAlignment =
    "@STEMGENRT_QUALIFIED_OUTPUT_ALIGNMENT@";
inline constexpr std::string_view kInputNamesJson =
    R"json(@STEMGENRT_QUALIFIED_METADATA_INPUT_NAMES@)json";
inline constexpr std::string_view kOutputNamesJson =
    R"json(@STEMGENRT_QUALIFIED_METADATA_OUTPUT_NAMES@)json";
inline constexpr std::string_view kSourceOrderJson =
    R"json(@STEMGENRT_QUALIFIED_METADATA_SOURCE_ORDER@)json";
inline constexpr std::string_view kFusionHiddenShapeJson =
    "[2,1,1000]";
inline constexpr std::string_view kC130HistoryShapeJson =
    "[1,20,128]";
inline constexpr std::string_view kPreviousHiddenShapeJson =
    "[1,32,512]";
inline constexpr std::string_view kAdapterValidShapeJson = "[1,1]";

struct MetadataEntry {
  std::string_view key;
  std::string_view value;
};

inline constexpr auto kMetadata = std::to_array<MetadataEntry>({
    {"hs_tasnet.checkpoint_sha256", kCheckpointSha256},
    {"hs_tasnet.c157.head_state_sha256", kHeadStateSha256},
    {"hs_tasnet.c157.safety_shortfall_db",
     "@STEMGENRT_QUALIFIED_METADATA_SAFETY_SHORTFALL_DB@"},
    {"hs_tasnet.deployment.quality_guards",
     "@STEMGENRT_QUALIFIED_METADATA_QUALITY_GUARDS@"},
    {"hs_tasnet.deployment.status",
     "@STEMGENRT_QUALIFIED_METADATA_DEPLOYMENT_STATUS@"},
    {"hs_tasnet.export.external_data", kExternalData},
    {"hs_tasnet.export.input_names", kInputNamesJson},
    {"hs_tasnet.export.mode", kExportMode},
    {"hs_tasnet.export.mixture_consistency", kMixtureConsistency},
    {"hs_tasnet.export.output_names", kOutputNamesJson},
    {"hs_tasnet.export.residual_source_index",
     "@STEMGENRT_QUALIFIED_RESIDUAL_SOURCE_INDEX@"},
    {"hs_tasnet.export.residual_source_name", "other"},
    {"hs_tasnet.external_data", kExternalData},
    {"hs_tasnet.model.causal_current_chunk",
     "@STEMGENRT_QUALIFIED_METADATA_CAUSAL_CURRENT_CHUNK@"},
    {"hs_tasnet.model.source_order", kSourceOrderJson},
    {"hs_tasnet.streaming.adapter_valid_shape", kAdapterValidShapeJson},
    {"hs_tasnet.streaming.analysis_window_samples",
     "@STEMGENRT_QUALIFIED_ANALYSIS_WINDOW_SAMPLES@"},
    {"hs_tasnet.streaming.c130_history_shape", kC130HistoryShapeJson},
    {"hs_tasnet.streaming.chunk_samples", "@STEMGENRT_QUALIFIED_HOP_SAMPLES@"},
    {"hs_tasnet.streaming.external_overlap_add",
     "@STEMGENRT_QUALIFIED_METADATA_EXTERNAL_OVERLAP_ADD@"},
    {"hs_tasnet.streaming.first_callback",
     "@STEMGENRT_QUALIFIED_METADATA_FIRST_CALLBACK@"},
    {"hs_tasnet.streaming.flush", "@STEMGENRT_QUALIFIED_METADATA_FLUSH@"},
    {"hs_tasnet.streaming.fusion_hidden_shape", kFusionHiddenShapeJson},
    {"hs_tasnet.streaming.initial_state",
     "@STEMGENRT_QUALIFIED_METADATA_INITIAL_STATE@"},
    {"hs_tasnet.streaming.output_alignment", kOutputAlignment},
    {"hs_tasnet.streaming.output_delay_hops",
     "@STEMGENRT_QUALIFIED_MODEL_OUTPUT_DELAY_CHUNKS@"},
    {"hs_tasnet.streaming.pdc_samples", "@STEMGENRT_QUALIFIED_HOP_SAMPLES@"},
    {"hs_tasnet.streaming.preroll",
     "@STEMGENRT_QUALIFIED_METADATA_PREROLL@"},
    {"hs_tasnet.streaming.previous_hidden_shape", kPreviousHiddenShapeJson},
    {"hs_tasnet.streaming.reset", "@STEMGENRT_QUALIFIED_METADATA_RESET@"},
});

static_assert(kInputAudioShape ==
              std::array<std::int64_t, 3>{1, kNumChannels, kHopSamples});
static_assert(kInputPastShape == kInputAudioShape);
static_assert(kInputHiddenShape ==
              std::array<std::int64_t, 3>{kFusionHiddenLayers, 1,
                                          kFusionHiddenSize});
static_assert(kInputC130HistoryShape ==
              std::array<std::int64_t, 3>{1, kC130FeatureChannels,
                                          kC130HistorySamples});
static_assert(kInputPreviousHiddenShape ==
              std::array<std::int64_t, 3>{1, kC155HiddenChannels,
                                          kC155HistorySamples});
static_assert(kInputAdapterValidShape ==
              std::array<std::int64_t, 2>{1, 1});
static_assert(kOutputSeparatedShape ==
              std::array<std::int64_t, 4>{1, kNumStems, kNumChannels,
                                          kHopSamples});
static_assert(kOutputPastShape == kInputAudioShape);
static_assert(kOutputHiddenShape == kInputHiddenShape);
static_assert(kOutputC130HistoryShape == kInputC130HistoryShape);
static_assert(kOutputPreviousHiddenShape == kInputPreviousHiddenShape);
static_assert(kOutputAdapterValidShape == kInputAdapterValidShape);
static_assert(kAnalysisWindowSamples == 2 * kHopSamples);
static_assert(kInputNames.size() == 6);
static_assert(kOutputNames.size() == 6);
static_assert(kNumChannels == 2);
static_assert(kNumStems == 4);
static_assert(kModelOutputDelayChunks == 0);
static_assert(kPdcSamples == kHopSamples);
static_assert(
    [] {
      for (const int index : kSourceOrder) {
        if (index < 0 || index >= kNumStems) {
          return false;
        }
      }
      return true;
    }(),
    "Every qualified source index must address an available stem");
static_assert(
    [] {
      for (std::size_t lhs = 0; lhs < kSourceOrder.size(); ++lhs) {
        for (std::size_t rhs = lhs + 1; rhs < kSourceOrder.size(); ++rhs) {
          if (kSourceOrder[lhs] == kSourceOrder[rhs]) {
            return false;
          }
        }
      }
      return true;
    }(),
    "Qualified source indices must be unique");
static_assert(kOtherSourceIndex == kResidualSourceIndex);
static_assert(kResidualSourceIndex >= 0 && kResidualSourceIndex < kNumStems);
static_assert(kOutputAlignment == "current_input_chunk",
              "The c157 native scheduler requires current-hop alignment");

}  // namespace audio_plugin::qualified_model
