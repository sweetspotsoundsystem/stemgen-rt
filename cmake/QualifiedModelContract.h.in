    "@STEMGENRT_QUALIFIED_OUTPUT_ALIGNMENT@";
inline constexpr std::string_view kInputNamesJson =
    R"json(@STEMGENRT_QUALIFIED_METADATA_INPUT_NAMES@)json";
inline constexpr std::string_view kOutputNamesJson =
    R"json(@STEMGENRT_QUALIFIED_METADATA_OUTPUT_NAMES@)json";
inline constexpr std::string_view kInputShapesJson =
    R"json(@STEMGENRT_QUALIFIED_METADATA_INPUT_SHAPES@)json";
inline constexpr std::string_view kOutputShapesJson =
    R"json(@STEMGENRT_QUALIFIED_METADATA_OUTPUT_SHAPES@)json";
inline constexpr std::string_view kSourceOrderJson =
    R"json(@STEMGENRT_QUALIFIED_METADATA_SOURCE_ORDER@)json";
inline constexpr std::string_view kAnalysisHistoryShapeJson = "[1,2,768]";
inline constexpr std::string_view kFusionHiddenShapeJson = "[2,1,1000]";
inline constexpr std::string_view kEmittedDbHistoryShapeJson = "[1,4,2048]";
inline constexpr std::string_view kStateNamesJson =
    R"json(@STEMGENRT_QUALIFIED_METADATA_STATE_NAMES@)json";

struct MetadataEntry {
  std::string_view key;
  std::string_view value;
};

inline constexpr auto kMetadata = std::to_array<MetadataEntry>({
    {"hs_tasnet.c191.emitted_db_history_shape", kEmittedDbHistoryShapeJson},
    {"hs_tasnet.c191.head_state_sha256", kC191HeadStateSha256},
    {"hs_tasnet.c191.partition_protocol",
     "sample_domain_causal_same_weights_new_256_parent_requires_requalification"},
    {"hs_tasnet.c191.payload_sha256", kC191PayloadSha256},
    {"hs_tasnet.c236.composite_runtime_state_sha256",
     kC236CompositeRuntimeStateSha256},
    {"hs_tasnet.c236.contract_identity_sha256", kC236ContractIdentitySha256},
    {"hs_tasnet.c236.evaluation_result_bound", kC236EvaluationResultBound},
    {"hs_tasnet.c236.family", kC236Family},
    {"hs_tasnet.c236.final_chain_receipt_sha256",
     kC236FinalChainReceiptSha256},
    {"hs_tasnet.c236.materialization_receipt_sha256",
     kC236MaterializationReceiptSha256},
    {"hs_tasnet.c236.materialized_artifact_sha256",
     kC236MaterializedArtifactSha256},
    {"hs_tasnet.c236.materializer_sha256", kC236MaterializerSha256},
    {"hs_tasnet.c236.materializer_verify_existing", "true"},
    {"hs_tasnet.c236.model_state_sha256", kC236ModelStateSha256},
    {"hs_tasnet.c236.previous_qualification_transferred", "false"},
    {"hs_tasnet.c236.qualification_v2_candidate_status",
     kC236QualificationV2CandidateStatus},
    {"hs_tasnet.c236.qualification_v2_sha256", kC236QualificationV2Sha256},
    {"hs_tasnet.c236.recovery_contract_sha256", kC236RecoveryContractSha256},
    {"hs_tasnet.c236.recovery_receipt_authority_sha256",
     kC236RecoveryReceiptAuthoritySha256},
    {"hs_tasnet.c236.recovery_receipt_sha256", kC236RecoveryReceiptSha256},
    {"hs_tasnet.c236.run_uuid", kC236RunUuid},
    {"hs_tasnet.c236.selected_update",
     "@STEMGENRT_QUALIFIED_C236_SELECTED_UPDATE@"},
    {"hs_tasnet.c236.shared_authority_sha256", kC236SharedAuthoritySha256},
    {"hs_tasnet.c236.source_checkpoint_sha256", kC236SourceCheckpointSha256},
    {"hs_tasnet.c236.static_identity_sha256", kC236StaticIdentitySha256},
    {"hs_tasnet.c236.terminal_chain_authority_sha256",
     kC236TerminalChainAuthoritySha256},
    {"hs_tasnet.contract.schema_version", "1"},
    {"hs_tasnet.deployment.status",
     "@STEMGENRT_QUALIFIED_METADATA_DEPLOYMENT_STATUS@"},
    {"hs_tasnet.export.dtype", "float32"},
    {"hs_tasnet.export.dynamo", "false"},
    {"hs_tasnet.export.external_data", kExternalData},
    {"hs_tasnet.export.input_names", kInputNamesJson},
    {"hs_tasnet.export.input_shapes_batch1", kInputShapesJson},
    {"hs_tasnet.export.mixture_consistency", kMixtureConsistency},
    {"hs_tasnet.export.mode", kExportMode},
    {"hs_tasnet.export.opset_version", "17"},
    {"hs_tasnet.export.output_filename", "model.onnx"},
    {"hs_tasnet.export.output_names", kOutputNamesJson},
    {"hs_tasnet.export.output_shapes_batch1", kOutputShapesJson},
    {"hs_tasnet.export.parity_semantics", "bounded_numeric_not_bit_exact"},
    {"hs_tasnet.export.residual_association",
     "audio_chunk-minus-sum-drums-bass-vocals-dim1-float32"},
    {"hs_tasnet.export.residual_source_index",
     "@STEMGENRT_QUALIFIED_RESIDUAL_SOURCE_INDEX@"},
    {"hs_tasnet.export.residual_source_name", "other"},
    {"hs_tasnet.model.candidate_kind", kModelCandidateKind},
    {"hs_tasnet.model.causal_current_chunk",
     "@STEMGENRT_QUALIFIED_METADATA_CAUSAL_CURRENT_CHUNK@"},
    {"hs_tasnet.model.checkpoint_sha256", kC236MaterializedArtifactSha256},
    {"hs_tasnet.model.checkpoint_state_sha256", kC236ModelStateSha256},
    {"hs_tasnet.model.source_order", kSourceOrderJson},
    {"hs_tasnet.streaming.analysis_history_samples",
     "@STEMGENRT_QUALIFIED_ANALYSIS_HISTORY_SAMPLES@"},
    {"hs_tasnet.streaming.analysis_history_shape", kAnalysisHistoryShapeJson},
    {"hs_tasnet.streaming.analysis_window_samples",
     "@STEMGENRT_QUALIFIED_ANALYSIS_WINDOW_SAMPLES@"},
    {"hs_tasnet.streaming.c191_correction", "true"},
    {"hs_tasnet.streaming.c191_qualification_transferred", "false"},
    {"hs_tasnet.streaming.chunk_samples", "@STEMGENRT_QUALIFIED_HOP_SAMPLES@"},
    {"hs_tasnet.streaming.external_overlap_add",
     "@STEMGENRT_QUALIFIED_METADATA_EXTERNAL_OVERLAP_ADD@"},
    {"hs_tasnet.streaming.first_callback",
     "@STEMGENRT_QUALIFIED_METADATA_FIRST_CALLBACK@"},
    {"hs_tasnet.streaming.flush", "@STEMGENRT_QUALIFIED_METADATA_FLUSH@"},
    {"hs_tasnet.streaming.fusion_hidden_shape", kFusionHiddenShapeJson},
    {"hs_tasnet.streaming.future_context_samples", "0"},
    {"hs_tasnet.streaming.initial_state",
     "@STEMGENRT_QUALIFIED_METADATA_INITIAL_STATE@"},
    {"hs_tasnet.streaming.output_alignment", kOutputAlignment},
    {"hs_tasnet.streaming.output_delay_hops",
     "@STEMGENRT_QUALIFIED_MODEL_OUTPUT_DELAY_CHUNKS@"},
    {"hs_tasnet.streaming.pdc_samples", "@STEMGENRT_QUALIFIED_HOP_SAMPLES@"},
    {"hs_tasnet.streaming.preroll", "@STEMGENRT_QUALIFIED_METADATA_PREROLL@"},
    {"hs_tasnet.streaming.reset", "@STEMGENRT_QUALIFIED_METADATA_RESET@"},
    {"hs_tasnet.streaming.sample_rate", "@STEMGENRT_QUALIFIED_SAMPLE_RATE@"},
    {"hs_tasnet.streaming.state_count",
     "@STEMGENRT_QUALIFIED_METADATA_STATE_COUNT@"},
    {"hs_tasnet.streaming.state_names", kStateNamesJson},
});

static_assert(kInputAudioShape ==
              std::array<std::int64_t, 3>{1, kNumChannels, kHopSamples});
static_assert(kInputAnalysisHistoryShape ==
              std::array<std::int64_t, 3>{1, kNumChannels,
                                          kAnalysisHistorySamples});
static_assert(kInputHiddenShape ==
              std::array<std::int64_t, 3>{kFusionHiddenLayers, 1,
                                          kFusionHiddenSize});
static_assert(kInputEmittedDbHistoryShape ==
              std::array<std::int64_t, 3>{1, kEmittedDbChannels,
                                          kEmittedDbHistorySamples});
static_assert(kOutputSeparatedShape ==
              std::array<std::int64_t, 4>{1, kNumStems, kNumChannels,
                                          kHopSamples});
static_assert(kOutputAnalysisHistoryShape == kInputAnalysisHistoryShape);
static_assert(kOutputHiddenShape == kInputHiddenShape);
static_assert(kOutputEmittedDbHistoryShape == kInputEmittedDbHistoryShape);
static_assert(kAnalysisHistorySamples + kHopSamples == kAnalysisWindowSamples);
static_assert(kInputNames.size() == 4);
static_assert(kOutputNames.size() == 4);
static_assert(kNumChannels == 2);
static_assert(kNumStems == 4);
static_assert(kModelOutputDelayChunks == 0);
static_assert(kPdcSamples == kHopSamples);
static_assert(
    [] {
      for (const int index : kSourceOrder) {
        if (index < 0 || index >= kNumStems) {
          return false;
        }
      }
      return true;
    }(),
    "Every qualified source index must address an available stem");
static_assert(
    [] {
      for (std::size_t lhs = 0; lhs < kSourceOrder.size(); ++lhs) {
        for (std::size_t rhs = lhs + 1; rhs < kSourceOrder.size(); ++rhs) {
          if (kSourceOrder[lhs] == kSourceOrder[rhs]) {
            return false;
          }
        }
      }
      return true;
    }(),
    "Qualified source indices must be unique");
static_assert(kOtherSourceIndex == kResidualSourceIndex);
static_assert(kResidualSourceIndex >= 0 && kResidualSourceIndex < kNumStems);
static_assert(kOutputAlignment == "current_input_chunk",
              "The c236 native scheduler requires current-hop alignment");

}  // namespace audio_plugin::qualified_model
