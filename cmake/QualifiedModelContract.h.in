    R"json(@STEMGENRT_QUALIFIED_METADATA_SOURCE_ORDER@)json";
inline constexpr std::string_view kFusionHiddenShapeJson =
    "[2,1,1000]";
inline constexpr std::string_view kC130HistoryShapeJson =
    "[1,20,128]";
inline constexpr std::string_view kPreviousHiddenShapeJson =
    "[1,32,512]";
inline constexpr std::string_view kAdapterValidShapeJson = "[1,1]";
inline constexpr std::string_view kRawParentHistoryShapeJson = "[1,4,2048]";
inline constexpr std::string_view kEmittedDbHistoryShapeJson = "[1,4,2048]";
inline constexpr std::string_view kStateNamesJson =
    R"json(@STEMGENRT_QUALIFIED_METADATA_STATE_NAMES@)json";

struct MetadataEntry {
  std::string_view key;
  std::string_view value;
};

inline constexpr auto kMetadata = std::to_array<MetadataEntry>({
    {"hs_tasnet.c193.candidate_id", kC193CandidateId},
    {"hs_tasnet.c193.full_runtime_state_sha256",
     kC193FullRuntimeStateSha256},
    {"hs_tasnet.c193.parent_state_sha256", kC193ParentStateSha256},
    {"hs_tasnet.c193.selected_head_sha256", kC193SelectedHeadSha256},
    {"hs_tasnet.c193.selected_head_state_sha256",
     kC193SelectedHeadStateSha256},
    {"hs_tasnet.c194.evaluation_sha256", kC194EvaluationSha256},
    {"hs_tasnet.c194.gate_sha256", kC194GateSha256},
    {"hs_tasnet.c197.evaluation_sha256", kC197EvaluationSha256},
    {"hs_tasnet.c197.gate_sha256", kC197GateSha256},
    {"hs_tasnet.c197.terminal_seal_sha256", kC197TerminalSealSha256},
    {"hs_tasnet.contract.schema_version", "1"},
    {"hs_tasnet.deployment.quality_guards",
     "@STEMGENRT_QUALIFIED_METADATA_QUALITY_GUARDS@"},
    {"hs_tasnet.deployment.status",
     "@STEMGENRT_QUALIFIED_METADATA_DEPLOYMENT_STATUS@"},
    {"hs_tasnet.export.external_data", kExternalData},
    {"hs_tasnet.export.input_names", kInputNamesJson},
    {"hs_tasnet.export.input_shapes_batch1", kInputShapesJson},
    {"hs_tasnet.export.inverse_dft_onesided", "false"},
    {"hs_tasnet.export.mode", kExportMode},
    {"hs_tasnet.export.mixture_consistency", kMixtureConsistency},
    {"hs_tasnet.export.native_dft", "true"},
    {"hs_tasnet.export.native_dft_node_count", "3"},
    {"hs_tasnet.export.native_dft_protocol",
     "two_rfft_one_full_hermitian_irfft_onnx_dft_opset17_ort126_v1"},
    {"hs_tasnet.export.opset_version", "17"},
    {"hs_tasnet.export.output_names", kOutputNamesJson},
    {"hs_tasnet.export.output_shapes_batch1", kOutputShapesJson},
    {"hs_tasnet.export.residual_association",
     "audio_chunk-minus-sum-cat-drums-bass-vocals-dim1-float32"},
    {"hs_tasnet.export.residual_source_index",
     "@STEMGENRT_QUALIFIED_RESIDUAL_SOURCE_INDEX@"},
    {"hs_tasnet.export.residual_source_name", "other"},
    {"hs_tasnet.external_data", kExternalData},
    {"hs_tasnet.model.causal_current_chunk",
     "@STEMGENRT_QUALIFIED_METADATA_CAUSAL_CURRENT_CHUNK@"},
    {"hs_tasnet.model.source_order", kSourceOrderJson},
    {"hs_tasnet.streaming.adapter_valid_shape", kAdapterValidShapeJson},
    {"hs_tasnet.streaming.analysis_window_samples",
     "@STEMGENRT_QUALIFIED_ANALYSIS_WINDOW_SAMPLES@"},
    {"hs_tasnet.streaming.c130_history_shape", kC130HistoryShapeJson},
    {"hs_tasnet.streaming.chunk_samples", "@STEMGENRT_QUALIFIED_HOP_SAMPLES@"},
    {"hs_tasnet.streaming.emitted_db_history_shape",
     kEmittedDbHistoryShapeJson},
    {"hs_tasnet.streaming.external_overlap_add",
     "@STEMGENRT_QUALIFIED_METADATA_EXTERNAL_OVERLAP_ADD@"},
    {"hs_tasnet.streaming.first_callback",
     "@STEMGENRT_QUALIFIED_METADATA_FIRST_CALLBACK@"},
    {"hs_tasnet.streaming.flush", "@STEMGENRT_QUALIFIED_METADATA_FLUSH@"},
    {"hs_tasnet.streaming.fusion_hidden_shape", kFusionHiddenShapeJson},
    {"hs_tasnet.streaming.public_fusion_state_protocol",
     "c178_public_fusion_state_equals_internal_times_2^-18_v1"},
    {"hs_tasnet.streaming.public_fusion_state_scale_exponent", "-18"},
    {"hs_tasnet.streaming.future_context_samples", "0"},
    {"hs_tasnet.streaming.initial_state",
     "@STEMGENRT_QUALIFIED_METADATA_INITIAL_STATE@"},
    {"hs_tasnet.streaming.output_alignment", kOutputAlignment},
    {"hs_tasnet.streaming.output_delay_hops",
     "@STEMGENRT_QUALIFIED_MODEL_OUTPUT_DELAY_CHUNKS@"},
    {"hs_tasnet.streaming.pdc_samples", "@STEMGENRT_QUALIFIED_HOP_SAMPLES@"},
    {"hs_tasnet.streaming.preroll",
     "@STEMGENRT_QUALIFIED_METADATA_PREROLL@"},
    {"hs_tasnet.streaming.previous_hidden_shape", kPreviousHiddenShapeJson},
    {"hs_tasnet.streaming.raw_parent_history_shape",
     kRawParentHistoryShapeJson},
    {"hs_tasnet.streaming.reset", "@STEMGENRT_QUALIFIED_METADATA_RESET@"},
    {"hs_tasnet.streaming.sample_rate", "@STEMGENRT_QUALIFIED_SAMPLE_RATE@"},
    {"hs_tasnet.streaming.state_count",
     "@STEMGENRT_QUALIFIED_METADATA_STATE_COUNT@"},
    {"hs_tasnet.streaming.state_names", kStateNamesJson},
});

static_assert(kInputAudioShape ==
              std::array<std::int64_t, 3>{1, kNumChannels, kHopSamples});
static_assert(kInputPastShape == kInputAudioShape);
static_assert(kInputHiddenShape ==
              std::array<std::int64_t, 3>{kFusionHiddenLayers, 1,
                                          kFusionHiddenSize});
static_assert(kInputC130HistoryShape ==
              std::array<std::int64_t, 3>{1, kC130FeatureChannels,
                                          kC130HistorySamples});
static_assert(kInputPreviousHiddenShape ==
              std::array<std::int64_t, 3>{1, kC155HiddenChannels,
                                          kC155HistorySamples});
static_assert(kInputAdapterValidShape ==
              std::array<std::int64_t, 2>{1, 1});
static_assert(kInputRawParentHistoryShape ==
              std::array<std::int64_t, 3>{1, kRawParentChannels,
                                          kRawParentHistorySamples});
static_assert(kInputEmittedDbHistoryShape ==
              std::array<std::int64_t, 3>{1, kEmittedDbChannels,
                                          kEmittedDbHistorySamples});
static_assert(kOutputSeparatedShape ==
              std::array<std::int64_t, 4>{1, kNumStems, kNumChannels,
                                          kHopSamples});
static_assert(kOutputPastShape == kInputAudioShape);
static_assert(kOutputHiddenShape == kInputHiddenShape);
static_assert(kOutputC130HistoryShape == kInputC130HistoryShape);
static_assert(kOutputPreviousHiddenShape == kInputPreviousHiddenShape);
static_assert(kOutputAdapterValidShape == kInputAdapterValidShape);
static_assert(kOutputRawParentHistoryShape == kInputRawParentHistoryShape);
static_assert(kOutputEmittedDbHistoryShape == kInputEmittedDbHistoryShape);
static_assert(kAnalysisWindowSamples == 2 * kHopSamples);
static_assert(kInputNames.size() == 8);
static_assert(kOutputNames.size() == 8);
static_assert(kNumChannels == 2);
static_assert(kNumStems == 4);
static_assert(kModelOutputDelayChunks == 0);
static_assert(kPdcSamples == kHopSamples);
static_assert(
    [] {
      for (const int index : kSourceOrder) {
        if (index < 0 || index >= kNumStems) {
          return false;
        }
      }
      return true;
    }(),
    "Every qualified source index must address an available stem");
static_assert(
    [] {
      for (std::size_t lhs = 0; lhs < kSourceOrder.size(); ++lhs) {
        for (std::size_t rhs = lhs + 1; rhs < kSourceOrder.size(); ++rhs) {
          if (kSourceOrder[lhs] == kSourceOrder[rhs]) {
            return false;
          }
        }
      }
      return true;
    }(),
    "Qualified source indices must be unique");
static_assert(kOtherSourceIndex == kResidualSourceIndex);
static_assert(kResidualSourceIndex >= 0 && kResidualSourceIndex < kNumStems);
static_assert(kOutputAlignment == "current_input_chunk",
              "The c193 native scheduler requires current-hop alignment");

}  // namespace audio_plugin::qualified_model
