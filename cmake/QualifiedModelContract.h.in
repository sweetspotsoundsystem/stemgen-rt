    std::to_array<std::int64_t>({@STEMGENRT_QUALIFIED_OUTPUT_HIDDEN_SHAPE@});
inline constexpr auto kOutputEmittedDbHistoryShape =
    std::to_array<std::int64_t>(
        {@STEMGENRT_QUALIFIED_OUTPUT_EMITTED_DB_HISTORY_SHAPE@});

