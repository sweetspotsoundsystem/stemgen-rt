    "@STEMGENRT_QUALIFIED_METADATA_EXPORT_MODE@";
inline constexpr std::string_view kMixtureConsistency =
    "@STEMGENRT_QUALIFIED_METADATA_MIXTURE_CONSISTENCY@";
inline constexpr std::string_view kExternalData =
    "@STEMGENRT_QUALIFIED_METADATA_EXTERNAL_DATA@";
inline constexpr std::string_view kOutputAlignment =
    "@STEMGENRT_QUALIFIED_OUTPUT_ALIGNMENT@";
inline constexpr std::string_view kInputNamesJson =
    R"json(@STEMGENRT_QUALIFIED_METADATA_INPUT_NAMES@)json";
inline constexpr std::string_view kOutputNamesJson =
    R"json(@STEMGENRT_QUALIFIED_METADATA_OUTPUT_NAMES@)json";
