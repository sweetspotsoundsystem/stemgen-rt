#pragma once
#include <array>
#include <cstdint>
#include <cstddef>
#include <string_view>
#include <utility>

namespace audio_plugin::qualified_model {
inline constexpr std::string_view kContractId = "@STEMGENRT_QUALIFIED_CONTRACT_ID@";
inline constexpr std::string_view kModelSha256 = "@STEMGENRT_QUALIFIED_MODEL_SHA256@";
inline constexpr std::int64_t kModelByteSize = @STEMGENRT_QUALIFIED_MODEL_BYTE_SIZE@;
inline constexpr std::string_view kOutputAlignment = "@STEMGENRT_QUALIFIED_OUTPUT_ALIGNMENT@";
inline constexpr std::string_view kPreroll = "discard_first_output_hop_after_reset";
inline constexpr int kSampleRate = @STEMGENRT_QUALIFIED_SAMPLE_RATE@;
inline constexpr int kNumChannels = @STEMGENRT_QUALIFIED_CHANNELS@;
inline constexpr int kNumStems = @STEMGENRT_QUALIFIED_STEMS@;
inline constexpr int kHopSamples = @STEMGENRT_QUALIFIED_HOP_SAMPLES@;
inline constexpr int kAnalysisWindowSamples = @STEMGENRT_QUALIFIED_ANALYSIS_WINDOW_SAMPLES@;
inline constexpr int kAnalysisHistorySamples = @STEMGENRT_QUALIFIED_ANALYSIS_HISTORY_SAMPLES@;
inline constexpr int kSynthesisFrameSamples = @STEMGENRT_QUALIFIED_SYNTHESIS_FRAME_SAMPLES@;
inline constexpr int kModelOutputDelayChunks = @STEMGENRT_QUALIFIED_MODEL_OUTPUT_DELAY_CHUNKS@;
inline constexpr int kAsyncQueueDelayChunks = @STEMGENRT_QUALIFIED_ASYNC_QUEUE_DELAY_CHUNKS@;
inline constexpr int kPluginLatencyChunks = @STEMGENRT_QUALIFIED_PLUGIN_LATENCY_CHUNKS@;
inline constexpr int kPluginLatencySamples = @STEMGENRT_QUALIFIED_PLUGIN_LATENCY_SAMPLES@;
inline constexpr int kDrumsSourceIndex = @STEMGENRT_QUALIFIED_DRUMS_SOURCE_INDEX@;
inline constexpr int kBassSourceIndex = @STEMGENRT_QUALIFIED_BASS_SOURCE_INDEX@;
inline constexpr int kVocalsSourceIndex = @STEMGENRT_QUALIFIED_VOCALS_SOURCE_INDEX@;
inline constexpr int kOtherSourceIndex = @STEMGENRT_QUALIFIED_OTHER_SOURCE_INDEX@;
inline constexpr int kResidualSourceIndex = @STEMGENRT_QUALIFIED_RESIDUAL_SOURCE_INDEX@;

inline constexpr auto kSourceOrder = std::to_array<int>({0, 1, 2, 3});
inline constexpr auto kInputNames = std::to_array<std::string_view>({
    @STEMGENRT_QUALIFIED_INPUT_NAMES_CPP@
});
inline constexpr auto kOutputNames = std::to_array<std::string_view>({
    @STEMGENRT_QUALIFIED_OUTPUT_NAMES_CPP@
});
struct StateShape {
  std::array<std::int64_t, 4> dimensions;
  std::size_t rank;
  constexpr const std::int64_t* data() const { return dimensions.data(); }
  constexpr std::size_t size() const { return rank; }
  constexpr std::size_t elements() const {
    std::size_t result = 1;
    for (std::size_t i = 0; i < rank; ++i)
      result *= static_cast<std::size_t>(dimensions[i]);
    return result;
  }
};
inline constexpr auto kStateShapes = std::to_array<StateShape>({
    @STEMGENRT_QUALIFIED_STATE_SHAPES_CPP@
});
inline constexpr std::array<std::int64_t, 3> kInputAudioShape{1, 2, 128};
inline constexpr std::array<std::int64_t, 4> kOutputSeparatedShape{1, 4, 2, 128};
inline constexpr auto kMetadata =
    std::to_array<std::pair<std::string_view, std::string_view>>({
        {"stemgenrt.experimental", R"meta(@STEMGENRT_QUALIFIED_METADATA_JSON@)meta"}
    });
static_assert(kInputNames.size() == kStateShapes.size() + 1);
static_assert(kOutputNames.size() == kInputNames.size());
static_assert(kStateShapes.size() == 13);
static_assert(kNumChannels == 2 && kNumStems == 4);
static_assert(kSampleRate == 44100 && kHopSamples == 128);
static_assert(kModelOutputDelayChunks == 1 && kAsyncQueueDelayChunks == 1);
static_assert(kPluginLatencyChunks == kModelOutputDelayChunks + kAsyncQueueDelayChunks);
static_assert(kPluginLatencySamples == kPluginLatencyChunks * kHopSamples);
static_assert(kPluginLatencySamples == 256);
static_assert(kOtherSourceIndex == kResidualSourceIndex);
}  // namespace audio_plugin::qualified_model
