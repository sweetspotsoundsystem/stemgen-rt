# Inspect the shipped layout without loading Windows code. This can also run
# on another platform when investigating a downloaded Windows release.
cmake_minimum_required(VERSION 3.22)
include("${CMAKE_CURRENT_LIST_DIR}/QualifiedModelContract.cmake")

if(NOT DEFINED STEMGENRT_BUNDLE_PATH)
  message(FATAL_ERROR "Set STEMGENRT_BUNDLE_PATH to the extracted StemgenRT.vst3")
endif()

set(_binary_dir "${STEMGENRT_BUNDLE_PATH}/Contents/x86_64-win")
set(_resources "${STEMGENRT_BUNDLE_PATH}/Contents/Resources")

foreach(_binary IN ITEMS StemgenRT.vst3 onnxruntime.dll)
  set(_path "${_binary_dir}/${_binary}")
  if(NOT EXISTS "${_path}" OR IS_DIRECTORY "${_path}")
    message(FATAL_ERROR "Missing Windows binary: ${_path}")
  endif()
  file(SIZE "${_path}" _size)
  if(_size LESS 64)
    message(FATAL_ERROR "Truncated Windows binary: ${_path}")
  endif()
  file(READ "${_path}" _magic LIMIT 2 HEX)
  if(NOT _magic STREQUAL "4d5a")
    message(FATAL_ERROR "Not a PE binary: ${_path}")
  endif()
  file(READ "${_path}" _offset_bytes OFFSET 60 LIMIT 4 HEX)
  string(REGEX REPLACE "(..)(..)(..)(..)" "\\4\\3\\2\\1" _offset_hex "${_offset_bytes}")
  math(EXPR _offset "0x${_offset_hex}")
  math(EXPR _header_end "${_offset} + 6")
  if(_offset LESS 64 OR _header_end GREATER _size)
    message(FATAL_ERROR "Invalid PE header offset: ${_path}")
  endif()
  file(READ "${_path}" _header OFFSET ${_offset} LIMIT 6 HEX)
  if(NOT _header STREQUAL "504500006486")
    message(FATAL_ERROR "Expected an x86-64 PE binary: ${_path}")
  endif()
endforeach()

set(_model "${_resources}/model.onnx")
if(NOT EXISTS "${_model}" OR IS_DIRECTORY "${_model}")
  message(FATAL_ERROR "Missing bundled model: ${_model}")
endif()
file(SIZE "${_model}" _model_size)
file(SHA256 "${_model}" _model_sha)
if(NOT "${_model_size}" STREQUAL "${STEMGENRT_QUALIFIED_MODEL_BYTE_SIZE}"
   OR NOT "${_model_sha}" STREQUAL "${STEMGENRT_QUALIFIED_MODEL_SHA256}")
  message(FATAL_ERROR "Bundled model does not match QualifiedModelContract.cmake")
endif()
if(EXISTS "${_resources}/model.onnx.data")
  message(FATAL_ERROR "Unexpected external model data in the single-file bundle")
endif()
if(NOT EXISTS "${_resources}/moduleinfo.json"
   OR IS_DIRECTORY "${_resources}/moduleinfo.json")
  message(FATAL_ERROR "Missing Windows VST3 manifest")
endif()

# CI compares the shipped runtime to the SDK used for this build. An offline
# release inspection can omit this argument; that does not verify DLL identity.
if(DEFINED STEMGENRT_EXPECTED_ORT_DLL)
  if(NOT EXISTS "${STEMGENRT_EXPECTED_ORT_DLL}")
    message(FATAL_ERROR "Expected SDK DLL does not exist")
  endif()
  file(SHA256 "${STEMGENRT_EXPECTED_ORT_DLL}" _expected_ort_sha)
  file(SHA256 "${_binary_dir}/onnxruntime.dll" _ort_sha)
  if(NOT _ort_sha STREQUAL _expected_ort_sha)
    message(FATAL_ERROR "Bundled ONNX Runtime DLL differs from the build SDK")
  endif()
endif()

message(STATUS "Verified Windows layout, x86-64 binaries and locked model identity")
